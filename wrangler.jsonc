{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youneek-stars",
  "main": "worker/index.ts",
  "account_id": "d74b0de637f4d9d9eb3efb9e13142784",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  // stars.youneek.xyz is intentionally NOT attached here. Andrew must approve
  // the custom-domain/DNS change separately before adding a route or deploying.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "STARS_DB",
    "database_name": "youneek-stars",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": { "CLAIM_MODE": "disabled" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
