{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youneek-stars",
  "main": "worker/index.ts",
  "account_id": "d74b0de637f4d9d9eb3efb9e13142784",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  // Andrew approved attaching only stars.youneek.xyz as this Worker's Custom
  // Domain (Nov 10, 2026). Do not add other hostnames, the youneek.xyz apex, or youneek.dev.
  "routes": [{ "pattern": "stars.youneek.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "STARS_DB",
    "database_name": "youneek-stars",
    "database_id": "7f15abe2-47ab-4788-9239-7020ddc1bd7f",
    "migrations_dir": "migrations"
  }],
  "vars": { "CLAIM_MODE": "disabled" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
